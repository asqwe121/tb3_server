#!/usr/bin/env python3
from threading import Thread
from typing import Dict
from rclpy.parameter import Parameter
import rclpy
from rclpy.node import Node
from rclpy.action import ActionClient
from rclpy.executors import MultiThreadedExecutor

from geometry_msgs.msg import PoseStamped
from nav2_msgs.action import NavigateToPose

from fastapi import FastAPI, HTTPException
import uvicorn


def yaw_to_quat(yaw: float):
    # Z-축 회전만 사용 (roll=pitch=0)
    return (0.0, 0.0, math.sin(yaw / 2.0), math.cos(yaw / 2.0))


class NavBridge(Node):
    def __init__(self):
        super().__init__("tb3_http_bridge")

        # ---- ROS 파라미터
        self.declare_parameter("robot_namespaces", [""])
        self.declare_parameter("frame_id", "map")
        self.declare_parameter("use_sim_time", True)
        self.declare_parameter("port", 8001)

        self.namespaces = list(self.get_parameter("robot_namespaces").value)
        self.frame_id = str(self.get_parameter("frame_id").value)
        self.port = int(self.get_parameter("port").value)

        # ---- Nav2 액션 클라이언트 준비
        self.clients: Dict[str, ActionClient] = {}
        for ns in self.namespaces:
            action_name = f"{ns}/navigate_to_pose" if ns else "/navigate_to_pose"
            self.clients[ns] = ActionClient(self, NavigateToPose, action_name)
            self.get_logger().info(f"[INIT] ActionClient for {action_name}")

        # ---- 홈 포즈 기본값 (0,0,0)
        self.home: Dict[str, PoseStamped] = {ns: self._mk_pose(0.0, 0.0, 0.0) for ns in self.namespaces}

        self.get_logger().info(
            f"[READY] HTTP bridge up: ns={self.namespaces}, frame='{self.frame_id}', port={self.port}"
        )

    def _mk_pose(self, x: float, y: float, yaw: float) -> PoseStamped:
        ps = PoseStamped()
        ps.header.frame_id = self.frame_id
        ps.header.stamp = self.get_clock().now().to_msg()
        qx, qy, qz, qw = yaw_to_quat(yaw)
        ps.pose.position.x = float(x)
        ps.pose.position.y = float(y)
        ps.pose.position.z = 0.0
        ps.pose.orientation.x = qx
        ps.pose.orientation.y = qy
        ps.pose.orientation.z = qz
        ps.pose.orientation.w = qw
        return ps

    async def send_goal(self, ns: str, x: float, y: float, yaw_deg: float):
        if ns not in self.clients:
            raise HTTPException(status_code=400, detail=f"Unknown namespace: {ns}")
        client = self.clients[ns]
        if not client.wait_for_server(timeout_sec=2.0):
            raise HTTPException(status_code=503, detail=f"Nav2 action not available for ns={ns}")

        goal = NavigateToPose.Goal()
        goal.pose = self._mk_pose(x, y, math.radians(yaw_deg))
        self.get_logger().info(f"[GOAL] ns={ns} -> ({x:.2f}, {y:.2f}, {yaw_deg:.1f}deg)")

        gh_future = client.send_goal_async(goal)
        goal_handle = await gh_future
        if not goal_handle.accepted:
            return {"accepted": False, "status": "REJECTED"}

        res_future = goal_handle.get_result_async()
        res = await res_future
        return {"accepted": True, "status": int(res.status)}

    def set_home(self, ns: str, x: float, y: float, yaw_deg: float):
        self.home[ns] = self._mk_pose(x, y, math.radians(yaw_deg))
        self.get_logger().info(f"[HOME] ns={ns} set to ({x:.2f},{y:.2f},{yaw_deg:.1f}deg)")

    async def rth(self, ns: str):
        hp = self.home.get(ns)
        if hp is None:
            raise HTTPException(status_code=404, detail=f"Home not set for ns={ns}")
        # 현재 홈 포즈에서 yaw 복원
        z, w = hp.pose.orientation.z, hp.pose.orientation.w
        yaw = math.atan2(2.0 * z * w, 1 - 2.0 * (z * z))
        return await self.send_goal(ns, hp.pose.position.x, hp.pose.position.y, math.degrees(yaw))


# ------------- FastAPI -------------
app = FastAPI()
_ros: Dict[str, object] = {"node": None, "executor": None, "thread": None}


@app.on_event("startup")
def _start_ros():
    if _ros["node"] is not None:
        return
    rclpy.init()
    node = NavBridge()
    exec_ = MultiThreadedExecutor()
    exec_.add_node(node)
    th = Thread(target=exec_.spin, daemon=True)
    th.start()
    _ros["node"] = node
    _ros["executor"] = exec_
    _ros["thread"] = th


@app.on_event("shutdown")
def _stop_ros():
    node: NavBridge = _ros["node"]
    exec_: MultiThreadedExecutor = _ros["executor"]
    if node and exec_:
        exec_.shutdown()
        node.destroy_node()
        rclpy.shutdown()


@app.post("/goal")
async def http_goal(body: dict):
    node: NavBridge = _ros["node"]
    ns = body.get("ns", "")
    x = float(body["x"])
    y = float(body["y"])
    yaw_deg = float(body.get("yaw_deg", 0.0))
    return await node.send_goal(ns, x, y, yaw_deg)


@app.post("/set_home")
def http_set_home(body: dict):
    node: NavBridge = _ros["node"]
    ns = body.get("ns", "")
    x = float(body["x"])
    y = float(body["y"])
    yaw_deg = float(body.get("yaw_deg", 0.0))
    node.set_home(ns, x, y, yaw_deg)
    return {"ok": True}


@app.post("/rth")
async def http_rth(body: dict):
    node: NavBridge = _ros["node"]
    ns = body.get("ns", "")
    return await node.rth(ns)


@app.get("/status")
def http_status():
    node: NavBridge = _ros["node"]
    return {
        "namespaces": node.namespaces,
        "frame_id": node.frame_id,
        "port": node.port,
    }


def main():
    import os
    port = int(os.environ.get("TB3_PORT", "8001"))
    # ✨ 문자열 "server:app" 대신 app 객체를 직접 넘긴다
    uvicorn.run(app, host="0.0.0.0", port=port, reload=False, log_level="info")


if __name__ == "__main__":
    main()
